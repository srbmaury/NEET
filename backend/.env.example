OPENAI_API_KEY=sk-replace-with-your-own-key
OPENAI_MODEL=gpt-4.1-mini
PORT=8080

# Postgres connection string, libpq/URI style — paste a Neon (or any Postgres host) connection
# string in as-is, e.g. postgresql://user:password@host/db?sslmode=require. Required; the backend
# won't start without it (see DatabaseFactory.kt for how this gets normalized into a JDBC URL).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Signing secret for account auth (JWT). Required; the backend won't start without it. Use a long
# random string — e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-secret
